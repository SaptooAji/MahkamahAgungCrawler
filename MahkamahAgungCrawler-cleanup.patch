-                .where(DiscoveryPageJob.run_id == run.id)
-                .order_by(DiscoveryPageJob.page_number)
-            ).all()
-        )
-
-        if created != PAGE_COUNT or len(job_ids) != PAGE_COUNT:
-            raise AssertionError(
